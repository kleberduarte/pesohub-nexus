NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Liga o gating de sessão no middleware.ts. Só pode ser "true" quando o cookie
# de sessão chega ao frontend: dev local (tudo em localhost) ou produção com
# app.* e api.* sob o mesmo domínio (COOKIE_DOMAIN no backend). Ligado com
# domínios separados, bloqueia todo mundo no /login.
# SESSION_MIDDLEWARE_ENABLED=true
